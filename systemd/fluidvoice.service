[Unit]
Description=FluidVoiceLinux dictation daemon
Documentation=https://github.com/acailic/FluidVoice
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/Documents/github/FluidVoiceLinux/.venv/bin/fluidvoice daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
