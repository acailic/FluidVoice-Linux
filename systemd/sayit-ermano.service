# SayItErmano systemd user unit (EXAMPLE).
# install.sh generates a copy with your real paths at
# ~/.config/systemd/user/sayit-ermano.service - prefer using that one.

[Unit]
Description=SayItErmano dictation daemon
Documentation=https://github.com/acailic/SayItErmano
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# The hotkey listener and xdotool insertion need the X session environment;
# a systemd user manager does NOT inherit it, so it must be set explicitly
# (install.sh bakes in the DISPLAY that was active during installation).
# On a Wayland login XDG_SESSION_TYPE/WAYLAND_DISPLAY outrank this DISPLAY
# in the session probe (fluidvoice/session.py) - verify they reached the
# user manager (systemctl --user show-environment) on a live session.
Environment=DISPLAY=%h/.sayit-ermano-display-see-install-sh
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=%h/Documents/github/SayItErmano/.venv/bin/sayit-ermano daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
