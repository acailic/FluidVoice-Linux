[Desktop Entry]
Type=Application
Name=SayItErmano Daemon
Comment=Start the SayItErmano dictation daemon at login
Comment[hr]=Pokreni SayItErmano diktaturu pri prijavi
Exec=/usr/bin/sayit-ermano daemon
Icon=sayit-ermano
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-KDE-autostart-after=panel
